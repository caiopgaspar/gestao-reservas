	<queryString>
		<![CDATA[SELECT 
    r.id,
    r.codigo_identificacao AS codigo,
    r.nome,
    r.localizacao,
    r.capacidade,
    tr.nome AS tipo_recurso
FROM recurso r
LEFT JOIN tipo_recurso tr ON r.tipo_recurso_id = tr.id
ORDER BY r.codigo_identificacao]]>
	</queryString>
	<field name="id" class="java.lang.Long"/>
	<field name="codigo" class="java.lang.String"/>
	<field name="nome" class="java.lang.String"/>
	<field name="localizacao" class="java.lang.String"/>
	<field name="capacidade" class="java.lang.Integer"/>
	<field name="tipo_recurso" class="java.lang.String"/>
